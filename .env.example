# Vite development proxy. Browser requests stay same-origin, so local TAS needs no CORS changes.
TAS_PROXY_TARGET=http://localhost:2005

# Optional browser API base URL (without /website or a trailing slash).
# Production defaults to https://tas.technulgy.com; development defaults to the proxy above.
# VITE_TAS_BASE_URL=https://tas.technulgy.com
